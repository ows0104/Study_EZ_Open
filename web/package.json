{
  "name": "studyez-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:pages": "node scripts/wait-for-api.mjs && npm run build && node scripts/wait-for-api.mjs --check",
    "pilot": "vite --config vite.pilot.config.ts --open /connection-pilot.html",
    "pilot:build": "vite build --config vite.pilot.config.ts",
    "pilot:test": "node --test tests/connection-pilot.test.cjs",
    "prototype": "vite --config vite.prototype.config.ts",
    "prototype:build": "vite build --config vite.prototype.config.ts",
    "dev": "npm run prepare-prompts && npm run pack-extension && vite",
    "pack-extension": "node scripts/pack-extension.mjs",
    "build": "npm run prepare-prompts && npm run pack-extension && tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "prepare-prompts": "node scripts/prepare-prompts.mjs"
  },
  "dependencies": {
    "@supabase/auth-js": "^2.112.3",
    "@types/sql.js": "^1.4.11",
    "fflate": "^0.8.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.0",
    "sql.js": "^1.14.2"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "~5.9.0",
    "vite": "^7.1.0"
  }
}
