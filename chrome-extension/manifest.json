{
  "manifest_version": 3,
  "name": "Study_EZ 예습 브리지",
  "version": "0.1.0",
  "description": "Study_EZ의 작년 필기와 예습 프롬프트를 ChatGPT 새 대화에 채우고, 만들어진 공유 링크를 강의에 되돌려 줍니다.",
  "permissions": ["storage", "tabs"],
  "host_permissions": [
    "https://*.r2.cloudflarestorage.com/*",
    "https://chatgpt.com/*",
    "http://localhost:5173/*",
    "http://localhost:8000/*",
    "http://127.0.0.1:8000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://study-ez-open.pages.dev/*", "http://localhost:5173/*"],
      "js": ["protocol.js", "studyez-bridge.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://chatgpt.com/*"],
      "js": ["protocol.js", "chatgpt-bridge.js", "chatgpt-share.js"],
      "run_at": "document_idle"
    }
  ]
}
