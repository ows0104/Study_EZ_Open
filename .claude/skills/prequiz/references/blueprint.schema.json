{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "예습확인퀴즈 청사진",
  "type": "object",
  "required": ["lecture_id", "lecture_summary", "objectives"],
  "properties": {
    "lecture_id": { "type": "string" },
    "lecture_summary": {
      "type": "string",
      "description": "이 강의가 무엇에 관한 것인지 3~4문장. 예습 전 학생이 읽는다고 생각하고 쓴다"
    },
    "exam_focus": {
      "type": "string",
      "description": "족보 구간에서 읽어낸 교수의 출제 성향. 문항으로 내지 않고 우선순위 판단에만 쓴다 (rules §2). 어느 지점을 몇 해가 물었는지 연도·번호와 함께 적는다 — 2단계가 짤족을 여기서 가린다 (rules §3.1)"
    },
    "objectives": {
      "type": "array",
      "description": "예습 목표. 강의당 4~7개",
      "items": {
        "type": "object",
        "required": ["id", "objective", "slides", "check_points"],
        "properties": {
          "id": { "type": "string", "pattern": "^obj_[0-9]+$" },
          "objective": {
            "type": "string",
            "description": "'~를 구별할 수 있다', '~의 인과 방향을 설명할 수 있다' 형태"
          },
          "slides": {
            "type": "array",
            "items": { "type": "integer" },
            "description": "이 목표를 다루는 강의록 슬라이드 번호. 족보 구간 번호를 넣지 않는다"
          },
          "check_points": {
            "type": "array",
            "description": "이 목표에서 확인할 지점. 이것이 문항이 된다",
            "items": {
              "type": "object",
              "required": ["target", "focus"],
              "properties": {
                "target": {
                  "type": "string",
                  "description": "무엇을 이해했는지 확인하는가. 문항 문장이 아니라 확인 지점"
                },
                "focus": {
                  "type": "string",
                  "enum": ["must_know", "core", "context"],
                  "description": "rules §4"
                },
                "exam_hit": {
                  "type": "boolean",
                  "description": "족보가 이 지점을 물었는가. 우선순위 근거"
                },
                "suggested_qtype": {
                  "type": "string",
                  "enum": ["mcq", "short", "ox"],
                  "description": "권장 유형. ②단계가 바꿔도 된다"
                }
              }
            }
          }
        }
      }
    },
    "skip_slides": {
      "type": "array",
      "items": { "type": "integer" },
      "description": "의도적으로 다루지 않는 강의록 슬라이드. 커버리지 검사에서 제외된다"
    },
    "skipped": {
      "type": "array",
      "description": "검토했으나 예습 문항으로 만들지 않기로 한 내용. 비워두지 말 것",
      "items": {
        "type": "object",
        "required": ["content", "reason"],
        "properties": {
          "content": { "type": "string" },
          "slide_no": { "type": "integer" },
          "reason": {
            "type": "string",
            "enum": ["too_detailed", "obvious", "decorative", "reference_only", "needs_lecture", "redundant"]
          }
        }
      }
    }
  }
}
