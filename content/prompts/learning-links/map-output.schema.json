{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "concept-map-extract/3"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "overview": {
      "type": "string",
      "minLength": 1
    },
    "concepts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "concept_id": {
            "type": "string",
            "pattern": "^C[0-9]{3,}$"
          },
          "parent_id": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^C[0-9]{3,}$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "core_facts": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "source_refs": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "source_id": {
                  "type": "string",
                  "minLength": 1
                },
                "pages": {
                  "type": "array",
                  "items": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "uniqueItems": true
                },
                "locator": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "minLength": 1
                }
              },
              "required": [
                "source_id",
                "pages",
                "locator"
              ],
              "additionalProperties": false,
              "anyOf": [
                {
                  "properties": {
                    "pages": {
                      "minItems": 1
                    }
                  }
                },
                {
                  "properties": {
                    "locator": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              ]
            },
            "minItems": 1
          }
        },
        "required": [
          "concept_id",
          "parent_id",
          "title",
          "core_facts",
          "source_refs"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "from_id": {
            "type": "string",
            "pattern": "^C[0-9]{3,}$"
          },
          "to_id": {
            "type": "string",
            "pattern": "^C[0-9]{3,}$"
          },
          "relation": {
            "type": "string",
            "minLength": 1
          },
          "source_refs": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "source_id": {
                  "type": "string",
                  "minLength": 1
                },
                "pages": {
                  "type": "array",
                  "items": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "uniqueItems": true
                },
                "locator": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "minLength": 1
                }
              },
              "required": [
                "source_id",
                "pages",
                "locator"
              ],
              "additionalProperties": false,
              "anyOf": [
                {
                  "properties": {
                    "pages": {
                      "minItems": 1
                    }
                  }
                },
                {
                  "properties": {
                    "locator": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              ]
            },
            "minItems": 1
          }
        },
        "required": [
          "from_id",
          "to_id",
          "relation",
          "source_refs"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    }
  },
  "required": [
    "schema_version",
    "title",
    "overview",
    "concepts",
    "relations",
    "notes"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "concepts": {
            "maxItems": 0
          }
        }
      },
      "then": {
        "properties": {
          "notes": {
            "minItems": 1
          },
          "relations": {
            "maxItems": 0
          }
        }
      }
    }
  ]
}