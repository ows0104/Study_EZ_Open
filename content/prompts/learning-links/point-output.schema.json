                  "status": {
                    "type": "string",
                    "enum": [
                      "supported",
                      "uncertain",
                      "not_identified"
                    ]
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1
                  },
                  "basis": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "enum": [
                        "structural_rationale"
                      ]
                    },
                    "minItems": 0
                  },
                  "evidence": {
                    "type": "array",
