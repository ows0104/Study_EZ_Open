                              }
                            },
                            "required": [
                              "source_id",
                              "pages",
                              "locator"
                            ],
                            "additionalProperties": false
                          },
                          "minItems": 1
                        }
                      }
                    }
                  }
                ]
              },
              "exam": {
                "type": "object",
                "properties": {
                  "status": {
                    "type": "string",
                    "enum": [
                      "supported",
                      "uncertain",
                      "not_identified"
                    ]
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1
                  },
                  "basis": {
                    "type": "array",
