                "source_id",
                "pages",
                "locator"
              ],
              "additionalProperties": false
            },
            "minItems": 0
          }
        },
        "required": [
          "description",
          "reason",
          "evidence"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "extraction_status": {
      "type": "string",
      "enum": [
        "extracted",
        "partial",
        "unreadable"
      ]
    }
  },
  "required": [
    "schema_version",
    "title",
    "sources",
    "scope",
    "summary",
    "groups",
    "points",
    "excluded_candidates",
    "extraction_status"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "extraction_status": {
            "const": "extracted"
          }
        }
      },
      "then": {
        "properties": {
          "groups": {
            "minItems": 1
          },
          "points": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "extraction_status": {
            "enum": [
              "partial",
              "unreadable"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "scope": {
            "properties": {
              "limitations": {
                "minItems": 1
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "extraction_status": {
            "const": "unreadable"
          }
        }
      },
      "then": {
        "properties": {
          "groups": {
            "maxItems": 0
          },
          "points": {
            "maxItems": 0
          },
          "excluded_candidates": {
            "maxItems": 0
          }
        }
      }
    }
  ]
