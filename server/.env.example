# local-test면 R2 대신 디스크를 쓰고 Supabase 검증을 건너뛴다.
# 배포에서는 production.
ENVIRONMENT=local-test

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/studyez

# Supabase — Auth만 쓴다. JWT 검증에 필요한 값이다.
# SUPABASE_JWT_SECRET을 주면 HS256, 비우면 JWKS로 RS256을 쓴다.
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_JWT_SECRET=

# Cloudflare R2
R2_ENDPOINT_URL=https://xxxxxxxx.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=studyez

# 로컬 러너가 산출물을 밀어 넣을 때 쓰는 공유 토큰. 사람의 로그인과 별개다.
RUNNER_TOKEN=

# 첫 로그인 때만 본다. 그 뒤로는 profile.is_admin이 사실이다.
STUDYEZ_ADMIN_EMAILS=developer@studyez.kr

# /c/ 대화 링크를 일반 사용자에게도 줄 것인가. 목표는 준다는 쪽이고, 지금 꺼 둔
# 것은 그 링크가 아직 불안정해서다. 안정되면 true로 바꾸면 된다.
STUDYEZ_SHOW_CONVERSATION_URL=false

# 프론트를 API와 같은 도메인에 두면(Cloudflare Pages + /api 라우트) 이 값은
# 비워도 된다.
CORS_ALLOWED_ORIGINS=http://localhost:5173
PUBLIC_API_BASE_URL=http://localhost:8000

# R2 버킷이 비공개라 링크는 서명해서 나간다. 기본 한 시간.
STUDYEZ_SIGNED_URL_TTL=3600
STUDYEZ_MAX_UPLOAD_MB=200
