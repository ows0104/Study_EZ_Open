                        "source_id": {
                          "type": "string",
                          "minLength": 1
                        },
                        "pages": {
                          "type": "array",
                          "items": {
                            "type": "integer",
                            "minimum": 1
                          },
                          "uniqueItems": true
                        },
                        "locator": {
                          "anyOf": [
                            {
