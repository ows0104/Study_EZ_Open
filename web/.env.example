# Supabase는 Auth만 쓴다. anon 키는 공개되어도 되는 값이다.
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=

# 비우면 같은 출처의 /api로 보낸다(개발 중에는 vite 프록시가 받는다).
VITE_API_BASE_URL=

# 세션 쿠키를 걸 등록 도메인. 형제 앱(기생충학 땅시)과 로그인을 나누려면
# 둘이 같은 값을 써야 한다. 비우면 이 호스트 전용이 되고 공유는 안 된다
# (로컬 개발과 pages.dev 비상 경로가 그 경우다).
VITE_SESSION_DOMAIN=
