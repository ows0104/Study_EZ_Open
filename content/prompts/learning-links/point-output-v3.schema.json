{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "exam-point-extract/3"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "points": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "point_id": {
            "type": "string",
            "pattern": "^P[0-9]{3,}$"
          },
          "point": {
            "type": "string",
            "minLength": 1
          },
          "source_refs": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "source_id": {
                  "type": "string",
                  "minLength": 1
                },
                "pages": {
                  "type": "array",
                  "items": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "uniqueItems": true
                },
                "locator": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "minLength": 1
                }
              },
              "required": [
                "source_id",
                "pages",
                "locator"
              ],
              "additionalProperties": false,
              "anyOf": [
                {
                  "properties": {
                    "pages": {
                      "minItems": 1
                    }
                  }
                },
                {
                  "properties": {
                    "locator": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              ]
            },
            "minItems": 1
          },
          "importance_basis": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "kind": {
                  "enum": [
                    "exam_forecast",
                    "exam_exclusion",
                    "writer_mark",
                    "current_exam",
                    "learning_objective",
                    "slide_emphasis",
                    "professor_remark",
                    "clinical",
                    "structural",
                    "writer_stamp",
                    "writer_remark",
                    "other_exam",
                    "last_year_emphasis"
                  ]
                },
                "refs": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "source_id": {
                        "type": "string",
                        "minLength": 1
                      },
                      "pages": {
                        "type": "array",
                        "items": {
                          "type": "integer",
                          "minimum": 1
                        },
                        "minItems": 1,
                        "uniqueItems": true
                      }
                    },
                    "required": [
                      "source_id",
                      "pages"
                    ],
                    "additionalProperties": false
                  },
                  "minItems": 1
                },
                "quote": {
                  "type": "string"
                },
                "reason": {
                  "type": "string",
                  "minLength": 1
                },
                "year": {
                  "type": [
                    "integer",
                    "null"
                  ]
                }
              },
              "required": [
                "kind",
                "refs",
                "quote",
                "reason",
                "year"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "point_id",
          "point",
          "source_refs",
          "importance_basis"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "notebook_profile": {
      "type": "object",
      "properties": {
        "legend": {
          "type": "string"
        },
        "emphasis_style": {
          "enum": [
            "slide",
            "verbal"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "legend",
        "emphasis_style",
        "reason"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "title",
    "points",
    "notes",
    "notebook_profile"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "points": {
            "maxItems": 0
          }
        }
      },
      "then": {
        "properties": {
          "notes": {
            "minItems": 1
          }
        }
      }
    }
  ]
}