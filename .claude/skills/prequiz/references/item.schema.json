{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "예습확인퀴즈 문항",
  "type": "object",
  "required": ["items"],
  "properties": {
    "lecture_id": { "type": "string" },
    "items": {
      "type": "array",
      "description": "정보량대로. 30문항을 넘지 않는다 (rules §3)",
      "items": {
        "type": "object",
        "required": [
          "objective_id", "retrieval_target", "qtype", "stem", "answer",
          "explanation", "slide_no", "source_anchor", "focus"
        ],
        "properties": {
          "id": { "type": "string", "description": "생략하면 코드가 p001부터 부여" },
          "objective_id": { "type": "string", "pattern": "^obj_[0-9]+$" },
          "retrieval_target": {
            "type": "string",
            "description": "청사진의 어떤 check_point를 확인하는가"
          },
          "qtype": {
            "type": "string",
            "enum": ["mcq", "short", "ox"],
            "description": "객관식 5지선다 / 단답 / OX"
          },
          "stem": {
            "type": "string",
            "description": "발문. 원본 없이 자족적이어야 한다. 선지 번호를 여기 적지 않는다 (rules §5)"
          },
          "choices": {
            "type": "array",
            "items": { "type": "string" },
            "minItems": 5,
            "maxItems": 5,
            "description": "qtype이 mcq일 때만. 정확히 5개, 선지 본문만. 번호(①②③)는 코드가 붙인다 (rules §7)"
          },
          "answer": {
            "type": "string",
            "description": "mcq는 정답 선지의 1-based 인덱스 문자열(\"3\"). ox는 \"O\" 또는 \"X\". short는 정답 명사구(40자 이내)"
          },
          "explanation": {
            "type": "string",
            "description": "① 왜 그 답인가 ② 가장 그럴듯한 오답이 왜 아닌가 ③ 강의에서 무엇을 들을 것인가. 40자 이상 (rules §8)"
          },
          "slide_no": {
            "type": "integer",
            "description": "각인된 Slide N 라벨에서 읽은 번호. 이 슬라이드 이미지가 카드 뒷면에 붙는다"
          },
          "source_type": {
            "type": "string",
            "enum": ["lecture", "jokbo"],
            "default": "lecture",
            "description": "slide_no가 강의록 구간이면 lecture, 족보 구간이면 jokbo. 실제 구간과 어긋나면 코드가 잡는다 (rules §2)"
          },
          "source_anchor": {
            "type": "string",
            "description": "슬라이드 안 어디인지 구체적으로. '두 번째 표의 3행'처럼 (rules §11)"
          },
          "focus": {
            "type": "string",
            "enum": ["must_know", "core", "context"],
            "description": "rules §4"
          },
          "exam_hit": {
            "type": "boolean",
            "description": "족보가 이 지점을 물었는가. 문항 자체는 강의록에서 나와야 한다 (rules §2)"
          }
        }
      }
    },
    "skipped": {
      "type": "array",
      "description": "청사진에 있었지만 문항을 만들지 않은 check_point. 비워두지 말 것",
      "items": {
        "type": "object",
        "required": ["retrieval_target", "reason"],
        "properties": {
          "retrieval_target": { "type": "string" },
          "reason": {
            "type": "string",
            "enum": ["too_detailed", "obvious", "decorative", "reference_only", "needs_lecture", "redundant"]
          }
        }
      }
    }
  }
}
