{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "시험 대비 카드 청사진",
  "description": "무엇을 물을지만 정한다. 카드(q/a)는 여기에 쓰지 않는다. 목표는 커버리지다.",
  "type": "object",
  "required": ["lecture_id", "objectives"],
  "properties": {
    "lecture_id": { "type": "string" },
    "summary": {
      "type": "string",
      "description": "이 강의가 무엇을 가르치는지 2~3문장"
    },
    "exam_focus": {
      "type": "object",
      "description": "족보 구간에서 읽어낸 교수의 출제 성향. 족보가 없으면 생략",
      "properties": {
        "years": {
          "type": "array",
          "items": { "type": "string" },
          "description": "확인된 출제 연도"
        },
        "question_count": { "type": "integer" },
        "hot_topics": {
          "type": "array",
          "items": { "type": "string" },
          "description": "문항이 몰린 주제. 이쪽은 촘촘히 출제한다"
        },
        "question_style": {
          "type": "string",
          "description": "개념을 묻는가, 임상 vignette으로 적용시키는가, 수치를 묻는가"
        },
        "trap_patterns": {
          "type": "array",
          "items": { "type": "string" },
          "description": "오답 선지가 만드는 혼동 패턴. trap 카드의 재료가 된다"
        }
      }
    },
    "estimated_item_count": {
      "type": "integer",
      "description": "예상 카드 수. 강의당 대략 50~90장이 보통이지만 목표치가 아니라 추정치다. 정보량에 따라 벗어나도 된다"
    },
    "skip_slides": {
      "type": "array",
      "items": { "type": "integer" },
      "description": "item-rules §1의 제외 사유에 해당하는 슬라이드 (표지·목차·참고용·출제 제외 명시 등)"
    },
    "objectives": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "objective", "slides", "retrieval_targets"],
        "properties": {
          "id": { "type": "string", "pattern": "^obj_[0-9]+$" },
          "objective": {
            "type": "string",
            "description": "학습자가 무엇을 할 수 있어야 하는가. '~를 안다'가 아니라 '~를 구분한다', '~를 설명한다'"
          },
          "source_type": {
            "type": "string",
            "enum": ["lecture", "jokbo"],
            "description": "강의록 구간의 목표인지 족보 구간의 목표인지"
          },
          "slides": {
            "type": "array",
            "items": { "type": "integer" },
            "description": "각인된 Slide N 라벨에서 읽은 번호"
          },
          "retrieval_targets": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["target", "importance"],
              "properties": {
                "target": {
                  "type": "string",
                  "description": "실제로 회수시킬 지식. 카드 하나에 대응하는 크기로 쪼갠다"
                },
                "importance": {
                  "type": "string",
                  "enum": ["core", "detail"]
                },
                "exam_hit": {
                  "type": "boolean",
                  "description": "족보가 이 지점을 물었는가"
                }
              }
            }
          },
          "priority_signal": {
            "type": "string",
            "enum": ["none", "student_note", "highlight", "red_box", "underline", "stamp", "summary_slide"],
            "description": "annotations.json에서 관측된 신호. stamp는 기출 출제 이력이므로 최우선"
          },
          "rejected_candidates": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["candidate", "reason"],
              "properties": {
                "candidate": { "type": "string" },
                "reason": {
                  "type": "string",
                  "enum": ["obvious", "decorative", "reference_only", "marked_not_tested", "redundant", "unsupported"]
                }
              }
            }
          }
        }
      }
    }
  }
}
