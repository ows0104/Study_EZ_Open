                          "type": "array",
                          "items": {
                            "type": "string",
                            "enum": [
                              "learning_objective",
                              "professor_exam_hint",
                              "professor_emphasis",
                              "same_professor_exam",
                              "other_professor_exam",
                              "note_taker_emphasis"
                            ]
                          },
                          "minItems": 1
                        },
                        "evidence": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "source_id": {
                                "type": "string",
                                "minLength": 1
                              },
                              "pages": {
                                "type": "array",
                                "items": {
                                  "type": "integer",
                                  "minimum": 1
                                },
                                "uniqueItems": true
                              },
                              "locator": {
                                "anyOf": [
                                  {
                                    "type": "string",
                                    "minLength": 1
                                  },
                                  {
                                    "type": "null"
                                  }
                                ]
                              }
                            },
                            "required": [
                              "source_id",
                              "pages",
                              "locator"
                            ],
                            "additionalProperties": false
                          },
                          "minItems": 1
                        }
                      }
                    }
                  }
                ]
              },
              "clinical": {
                "type": "object",
                "properties": {
                  "status": {
                    "type": "string",
                    "enum": [
                      "supported",
                      "uncertain",
                      "not_identified"
                    ]
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1
                  },
                  "basis": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "enum": [
                        "clinical_rationale"
                      ]
                    },
                    "minItems": 0
                  },
                  "evidence": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "source_id": {
                          "type": "string",
                          "minLength": 1
                        },
                        "pages": {
                          "type": "array",
                          "items": {
                            "type": "integer",
                            "minimum": 1
                          },
                          "uniqueItems": true
                        },
                        "locator": {
                          "anyOf": [
                            {
                              "type": "string",
                              "minLength": 1
                            },
                            {
                              "type": "null"
                            }
                          ]
                        }
                      },
                      "required": [
                        "source_id",
                        "pages",
                        "locator"
                      ],
                      "additionalProperties": false
                    },
                    "minItems": 0
                  }
                },
                "required": [
                  "status",
                  "reason",
                  "basis",
                  "evidence"
                ],
                "additionalProperties": false,
                "allOf": [
                  {
                    "if": {
                      "properties": {
                        "status": {
                          "const": "supported"
                        }
                      }
                    },
                    "then": {
                      "properties": {
                        "basis": {
                          "type": "array",
                          "items": {
                            "type": "string",
                            "enum": [
                              "clinical_rationale"
                            ]
                          },
                          "minItems": 1
                        },
                        "evidence": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "source_id": {
                                "type": "string",
                                "minLength": 1
                              },
                              "pages": {
                                "type": "array",
                                "items": {
                                  "type": "integer",
                                  "minimum": 1
                                },
                                "uniqueItems": true
                              },
                              "locator": {
                                "anyOf": [
                                  {
                                    "type": "string",
                                    "minLength": 1
                                  },
                                  {
                                    "type": "null"
                                  }
                                ]
                              }
                            },
                            "required": [
                              "source_id",
                              "pages",
                              "locator"
                            ],
                            "additionalProperties": false
                          },
                          "minItems": 1
                        }
                      }
                    }
                  }
                ]
              }
            },
            "required": [
              "structural",
              "exam",
              "clinical"
            ],
            "additionalProperties": false
          },
          "advanced": {
            "type": "object",
            "properties": {
              "status": {
                "type": "string",
                "enum": [
                  "yes",
                  "no",
                  "uncertain"
                ]
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "status",
              "reason"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "point_id",
          "group_id",
          "objective",
          "requirement",
          "requirement_reason",
          "directions",
          "importance",
          "advanced"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "excluded_candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "description": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "source_id": {
                  "type": "string",
                  "minLength": 1
                },
                "pages": {
                  "type": "array",
