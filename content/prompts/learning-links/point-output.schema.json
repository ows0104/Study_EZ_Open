              "notes",
              "exam",
              "other"
            ]
          },
          "professor": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "year": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1900
          },
          "page_count": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          }
        },
        "required": [
          "source_id",
          "label",
          "kind",
          "professor",
          "year",
          "page_count"
