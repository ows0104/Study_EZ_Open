# local-test면 R2 대신 디스크를 쓰고 Supabase 검증을 건너뛴다.
# 배포에서는 production.
ENVIRONMENT=local-test

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/studyez

# Supabase — Auth만 쓴다. JWT 검증에 필요한 값이다.
# SUPABASE_JWT_SECRET을 주면 HS256, 비우면 JWKS로 RS256을 쓴다.
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_JWT_SECRET=

# Cloudflare R2
R2_ENDPOINT_URL=https://xxxxxxxx.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=studyez

# 로컬 러너가 산출물을 밀어 넣을 때 쓰는 공유 토큰. 사람의 로그인과 별개다.
RUNNER_TOKEN=

# 첫 로그인 때만 본다. 그 뒤로는 profile.is_admin이 사실이다.
STUDYEZ_ADMIN_EMAILS=developer@studyez.kr

CORS_ALLOWED_ORIGINS=http://localhost:5173
PUBLIC_API_BASE_URL=http://localhost:8000

# 제3자 저작물이라 링크 수명은 분 단위다.
STUDYEZ_SIGNED_URL_TTL=300
STUDYEZ_MAX_UPLOAD_MB=200
